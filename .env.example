# ========================================
# 🔐 Environment Configuration
# ========================================

# ---- Server Configuration ----
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ---- Database Configuration ----
DATABASE_URL=postgresql://postgres:secure_password@localhost:5432/b2b_web3
DATABASE_POOL_SIZE=20
DATABASE_TIMEOUT=30000

# ---- Redis Configuration ----
REDIS_URL=redis://:redis_password@localhost:6379/0
REDIS_DB=0
REDIS_CACHE_TTL=3600

# ========================================
# 🔐 JWT Security Configuration
# ========================================
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars_required
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_required
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ========================================
# 🔐 API Rate Limiting & Security
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=https://yourdomain.com,https://admin.yourdomain.com
TRUST_PROXY=1
SESSION_SECRET=your_session_secret_key_min_32_chars

# ========================================
# 🌐 EVM Blockchain Providers (Ethereum, Polygon, Arbitrum, etc.)
# ========================================

# Alchemy Provider
ALCHEMY_ETHEREUM_URL=https://eth-mainnet.alchemyapi.io/v2/YOUR_ALCHEMY_KEY
ALCHEMY_POLYGON_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_ARBITRUM_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_OPTIMISM_URL=https://opt-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ALCHEMY_API_KEY=YOUR_ALCHEMY_API_KEY

# Infura Provider
INFURA_ETHEREUM_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
INFURA_POLYGON_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
INFURA_ARBITRUM_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
INFURA_OPTIMISM_URL=https://optimism-mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID
INFURA_PROJECT_ID=YOUR_INFURA_PROJECT_ID

# ========================================
# 🟢 TRON Blockchain Providers
# ========================================

# TronGrid - Official TRON RPC Provider
TRONGRID_URL=https://api.trongrid.io
TRONGRID_API_KEY=YOUR_TRONGRID_API_KEY
TRONGRID_TESTNET_URL=https://api.shasta.trongrid.io

# TronScan - TRON Block Explorer & API
TRONSCAN_API_URL=https://api.tronscan.org/api
TRONSCAN_API_KEY=YOUR_TRONSCAN_API_KEY

# Tron Testnet Configuration
TRON_TESTNET_ENABLED=false
TRON_PRIVATE_NETWORKS=https://api.nile.trongrid.io

# ========================================
# 🔐 Admin & User Management
# ========================================

# Default Admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=
ADMIN_2FA_ENABLED=true

# User Management
USER_REGISTRATION_ENABLED=false
USER_APPROVAL_REQUIRED=true
USER_MAX_SESSIONS=5
USER_SESSION_TIMEOUT=1800

# ========================================
# 🛡️ Security & Encryption
# ========================================

# Encryption Keys (Keep these secret!)
ENCRYPTION_MASTER_KEY=your_master_encryption_key_min_32_chars
ENCRYPTION_ALGORITHM=aes-256-gcm

# API Key Encryption
API_KEY_ENCRYPTION_ENABLED=true
API_KEY_ROTATION_DAYS=90

# ========================================
# 📊 Audit & Logging
# ========================================

LOG_LEVEL=info
LOG_FORMAT=json
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# ========================================
# 📈 Monitoring & Analytics
# ========================================

MONITORING_ENABLED=true
PROMETHEUS_METRICS_ENABLED=true
SENTRY_DSN=

# ========================================
# 🚀 Deployment & Infrastructure
# ========================================

DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_NAME=yourusername/b2b-web3-rpc-service
KUBERNETES_NAMESPACE=production
KUBERNETES_REPLICAS=3
