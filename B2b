#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_NAME="${1:-b2b-web3-rpc-service}"
REPO_DESC="${2:-Enterprise Web3 RPC Service with Admin}"
VISIBILITY="${3:-private}" # private or public
GITHUB_ORG="${4:-}" # optional
REGISTRY_CHOICE="${5:-ghcr}" # ghcr or dockerhub (optional for CI setup)

# Prereqs check
if ! command -v gh >/dev/null 2>&1; then
  echo "Error: gh CLI not found. Install and authenticate first."
  exit 1
fi
if ! command -v git >/dev/null 2>&1; then
  echo "Error: git not found. Install git first."
  exit 1
fi

# --- Project scaffold (minimal safe scaffold if files missing) ---
# Create basic structure only if not present
[ -d src ] || mkdir -p src
[ -d frontend-admin ] || mkdir -p frontend-admin/src
[ -d prisma ] || mkdir -p prisma
[ -d deploy ] || mkdir -p deploy

# .gitignore
